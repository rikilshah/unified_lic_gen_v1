<Window
    x:Class="UnifiedLicGen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="WindowLayoutRoot" Background="{StaticResource CanvasBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveWindowStates">
                <VisualState x:Name="CompactWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Navigation.PaneDisplayMode" Value="LeftCompact" />
                        <Setter Target="Navigation.IsPaneOpen" Value="False" />
                        <Setter Target="Navigation.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="HeaderVersionText.Visibility" Value="Collapsed" />
                        <Setter Target="StatusVersionGroup.Visibility" Value="Collapsed" />
                        <Setter Target="PageHost.Padding" Value="12,10,12,12" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StandardWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Navigation.PaneDisplayMode" Value="Left" />
                        <Setter Target="Navigation.IsPaneOpen" Value="True" />
                        <Setter Target="Navigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="HeaderVersionText.Visibility" Value="Visible" />
                        <Setter Target="StatusVersionGroup.Visibility" Value="Visible" />
                        <Setter Target="PageHost.Padding" Value="16,12,16,14" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Navigation.PaneDisplayMode" Value="Left" />
                        <Setter Target="Navigation.IsPaneOpen" Value="True" />
                        <Setter Target="Navigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="HeaderVersionText.Visibility" Value="Visible" />
                        <Setter Target="StatusVersionGroup.Visibility" Value="Visible" />
                        <Setter Target="PageHost.Padding" Value="24,14,24,16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="16,0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="UNIFIED CONTROL" />
                    </StackPanel>
                    <TextBlock x:Name="HeaderVersionText" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Text="TEST • AUTH • PROVISION" />
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{StaticResource ErrorBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionText" Text="Disconnected" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="DeviceTypeText" Style="{StaticResource SecondaryTextStyle}" FontSize="10" Text="No cards" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border x:Name="AsmIdentityGroup" Grid.Column="1" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="ASM" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="SERIAL" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="AsmSerialTopText" Grid.Column="1" FontFamily="Cascadia Mono" FontSize="12" FontWeight="SemiBold" Text="—" /></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="CUST" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="AsmCustomerIdTopText" Grid.Column="1" FontFamily="Cascadia Mono" FontSize="12" Text="0000000000" /></Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="StepperIdentityGroup" Grid.Column="2" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="STEPPER" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="SERIAL" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="StepperSerialTopText" Grid.Column="1" FontFamily="Cascadia Mono" FontSize="12" FontWeight="SemiBold" Text="—" /></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="CUST" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="StepperCustomerIdTopText" Grid.Column="1" FontFamily="Cascadia Mono" FontSize="12" Text="0000000000" /></Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="AuthBadge" Grid.Column="3" Background="#332B3746" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="AuthText" FontSize="11" Text="NOT AUTHORIZED" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button Click="SettingsButton_Click" MinHeight="30" Padding="10,4" FontSize="13" ToolTipService.ToolTip="Connection and application settings">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE713;" /><TextBlock Text="Settings" /></StackPanel>
                    </Button>
                    <Button x:Name="DisconnectButton" Click="DisconnectButton_Click" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" Content="Disconnect" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsPaneToggleButtonVisible="False"
                        OpenPaneLength="218" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" Background="{StaticResource CanvasBrush}"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="1  Read card" Tag="wizard1"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="2  Create identity" Tag="wizard2"><NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="3  Generate &amp; stage" Tag="wizard3"><NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="4  Review &amp; flash" Tag="wizard4"><NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Verify board" Tag="verify"><NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="ASM controls" Tag="asm"><NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Stepper controls" Tag="stepper"><NavigationViewItem.Icon><FontIcon Glyph="&#xEC4A;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Test center" Tag="tests"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid x:Name="PageHost" Padding="16,12,16,14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </NavigationView>

        <Border Grid.Row="2" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="Ready. Select a hardware profile or connect a device." TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                    <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock x:Name="ControlAccessStatusText" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="CONTROLS LOCKED  /  VERIFIED MANIFEST REQUIRED" />
                </StackPanel>
                <TextBlock x:Name="CustomerIdStatusText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" FontFamily="Cascadia Mono" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="CUST ID  0000000000  /  UNPROVISIONED" />
                <StackPanel x:Name="StatusVersionGroup" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="StatusVersionText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="UnifiedLicGen" />
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="SettingsPopup" IsLightDismissEnabled="True">
            <Border x:Name="SettingsDrawer" Width="420" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Translation="0,0,32">
                <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Connection, polling and service options" /></StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseSettings_Click" MinHeight="30" Padding="10,4" FontSize="13" Content="Close" />
                        </Grid>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Connection" />
                                <TextBlock Text="Both supported card types are probed on this shared port." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PortBox" Header="COM port" PlaceholderText="No ports found" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="RefreshPorts_Click" MinHeight="30" Padding="10,4" FontSize="13" Content="Refresh" />
                                </Grid>
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="BaudBox" Header="Baud" SelectedIndex="2"><ComboBoxItem Content="9600" /><ComboBoxItem Content="19200" /><ComboBoxItem Content="38400" /><ComboBoxItem Content="115200" /></ComboBox>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <NumberBox x:Name="AsmSlaveIdBox" Width="82" Header="ASM ID" Value="1" Minimum="1" Maximum="247" SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="StepperSlaveIdBox" Width="82" Header="Stepper ID" Value="2" Minimum="1" Maximum="247" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </Grid>
                                <Button Click="ConnectButton_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Connect and identify" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Polling &amp; behavior" />
                                <NumberBox x:Name="LiveStatusIntervalBox" Header="Live status interval (ms)" Value="300" Minimum="100" Maximum="5000" SpinButtonPlacementMode="Compact" />
                                <ToggleSwitch Header="Reconnect monitoring" IsOn="True" />
                                <ToggleSwitch Header="Confirm motion commands" IsOn="True" />
                                <ToggleSwitch Header="Include backend authorization" IsOn="False" />
                            </StackPanel>
                        </Border>
                        <Expander Header="Service and diagnostics">
                            <StackPanel Spacing="10" Padding="0,10,0,0">
                                <PasswordBox x:Name="MasterPasswordBox" Header="Temporary service unlock" PlaceholderText="Service password" />
                                <Button Click="ServiceUnlock_Click" MinHeight="30" Padding="10,4" FontSize="13" Content="Unlock for this session" />
                                <ToggleSwitch Header="Show raw protocol diagnostics" />
                                <Button MinHeight="30" Padding="10,4" FontSize="13" Content="Open log folder" />
                            </StackPanel>
                        </Expander>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="FlashSummaryPopup" IsLightDismissEnabled="True">
            <Border Width="520" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24" Translation="0,0,32">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Ready to flash" />
                        <Button HorizontalAlignment="Right" Click="CloseFlashSummary_Click" Content="Close" />
                    </Grid>
                    <TextBlock x:Name="FlashSummaryText" FontFamily="Cascadia Mono" TextWrapping="Wrap" />
                    <StackPanel x:Name="FlashProgressPanel" Spacing="6" Visibility="Collapsed">
                        <ProgressBar x:Name="FlashProgressBar" Minimum="0" Maximum="100" Height="8" />
                        <TextBlock x:Name="FlashProgressText" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <CheckBox x:Name="FlashAcknowledge" Content="I verified the connected card and ST-LINK target." />
                    <TextBox x:Name="FlashSerialConfirmation" Header="Type the assigned serial to confirm" FontFamily="Cascadia Mono" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Click="CloseFlashSummary_Click" Content="Cancel" />
                        <Button x:Name="FinalFlashButton" Click="FinalFlash_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Flash and verify" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
