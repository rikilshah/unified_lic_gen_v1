<Application
    x:Class="UnifiedLicGen.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="CanvasColor">#0B0F14</Color>
                    <Color x:Key="NavColor">#0F141B</Color>
                    <Color x:Key="SurfaceColor">#151B23</Color>
                    <Color x:Key="RaisedColor">#1B2430</Color>
                    <Color x:Key="BorderColor">#2B3746</Color>
                    <Color x:Key="TextPrimaryColor">#F2F5F8</Color>
                    <Color x:Key="TextSecondaryColor">#9EABB9</Color>
                    <Color x:Key="AccentColor">#39C6D4</Color>
                    <Color x:Key="SuccessColor">#48C78E</Color>
                    <Color x:Key="WarningColor">#F4B860</Color>
                    <Color x:Key="ErrorColor">#FF6B6B</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource CanvasColor}" />
            <SolidColorBrush x:Key="NavBrush" Color="{ThemeResource NavColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
            <SolidColorBrush x:Key="RaisedBrush" Color="{ThemeResource RaisedColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource BorderColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource AccentColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
            <SolidColorBrush x:Key="ErrorBrush" Color="{ThemeResource ErrorColor}" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="DataTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#071014" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style TargetType="NumberBox">
                <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
