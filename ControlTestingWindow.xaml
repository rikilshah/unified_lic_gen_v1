<Window
    x:Class="UnifiedLicGen.ControlTestingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource CanvasBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Control &amp; Testing" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Separate workspaces for ASM and Stepper cards" />
            </StackPanel>
            <Button Grid.Column="1" Click="Disconnect_Click" Content="Disconnect" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" /><ColumnDefinition Width="240" /><ColumnDefinition Width="130" />
                    <ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="HardwareBox" Header="Hardware" SelectedIndex="0">
                    <ComboBoxItem Content="ASM I/O Card" Tag="asm" />
                    <ComboBoxItem Content="Stepper Motion Card" Tag="stepper" />
                </ComboBox>
                <ComboBox x:Name="PortBox" Grid.Column="1" Header="COM port" />
                <ComboBox x:Name="BaudBox" Grid.Column="2" Header="Baud" SelectedIndex="2">
                    <ComboBoxItem Content="9600" /><ComboBoxItem Content="19200" /><ComboBoxItem Content="38400" /><ComboBoxItem Content="115200" />
                </ComboBox>
                <NumberBox x:Name="SlaveBox" Grid.Column="3" Header="Slave" Value="2" Minimum="1" Maximum="247" />
                <Button Grid.Column="4" VerticalAlignment="Bottom" Click="Connect_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Connect" />
                <TextBlock x:Name="IdentityText" Grid.Column="5" Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Cascadia Mono" Foreground="{StaticResource TextSecondaryBrush}" Text="No card connected" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <TabView x:Name="HardwareTabs" Grid.Row="2" IsAddTabButtonVisible="False">
            <TabViewItem Header="ASM I/O Card">
                <ScrollViewer><StackPanel Spacing="14" Padding="0,12,12,12">
                    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Live inputs" />
                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ToggleSwitch Header="IP1" IsEnabled="False" /><ToggleSwitch Grid.Column="1" Header="IP2" IsEnabled="False" />
                            </Grid>
                            <Button Click="RefreshAsm_Click" Content="Refresh card status" />
                        </StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Digital outputs" />
                            <ToggleSwitch Header="Blower" Toggled="ControlChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ControlAction_Click" Content="Apply outputs" /><Button Click="ControlAction_Click" Content="Read back" /></StackPanel>
                        </StackPanel></Border>
                    </Grid>
                    <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="PWM outputs" />
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <NumberBox Header="PWM1 duty" Minimum="0" Maximum="1023" /><NumberBox Grid.Column="1" Header="PWM2 duty" Minimum="0" Maximum="1023" />
                            <NumberBox Grid.Column="2" Header="Frequency (Hz)" Value="1000" Minimum="1" Maximum="65535" /><Button Grid.Column="3" VerticalAlignment="Bottom" Click="ControlAction_Click" Content="Apply PWM" />
                        </Grid>
                    </StackPanel></Border>
                    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="WS2812 lighting" /><ColorPicker IsAlphaEnabled="False" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ControlAction_Click" Content="Apply color" /><Button Click="ControlAction_Click" Content="Clear" /></StackPanel></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="ASM test suite" /><CheckBox Content="Communication and identity" /><CheckBox Content="Inputs and outputs" /><CheckBox Content="PWM readback" /><CheckBox Content="Lighting update" /><Button Click="RunTests_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Run ASM tests" /></StackPanel></Border>
                    </Grid>
                </StackPanel></ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Stepper Motion Card">
                <ScrollViewer><StackPanel Spacing="14" Padding="0,12,12,12">
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="POSITION" /><TextBlock x:Name="StepperPosition" FontSize="24" FontFamily="Cascadia Mono" Text="-" /></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="COMMAND" /><TextBlock x:Name="StepperCommand" FontSize="24" FontFamily="Cascadia Mono" Text="-" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="STATUS" /><TextBlock x:Name="StepperStatus" FontSize="24" FontFamily="Cascadia Mono" Text="-" /></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="FAULT" /><TextBlock x:Name="StepperFault" FontSize="24" FontFamily="Cascadia Mono" Text="-" /></StackPanel></Border>
                    </Grid>
                    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Positioning" /><NumberBox Header="Relative pulses" Value="1000" /><Button Click="ControlAction_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Move relative" /><NumberBox Header="Absolute position" /><Button Click="ControlAction_Click" Content="Move absolute" /></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Jog and home" /><NumberBox Header="Jog chunk" Value="100" Minimum="1" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ControlAction_Click" Content="Jog -" /><Button Click="ControlAction_Click" Content="Jog +" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ControlAction_Click" Content="Reset position" /><Button Click="ControlAction_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Start homing" /></StackPanel></StackPanel></Border>
                    </Grid>
                    <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Drive configuration" /><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><NumberBox Header="Microstep" Value="16" /><NumberBox Grid.Column="1" Header="Pulses/rev" Value="3200" /><NumberBox Grid.Column="2" Header="Acceleration" Value="1000" /><NumberBox Grid.Column="3" Header="Deceleration" Value="1000" /><NumberBox Grid.Column="4" Header="Velocity" Value="2000" /></Grid><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ReadStepper_Click" Content="Read card" /><Button Click="ControlAction_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Write configuration" /></StackPanel></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Stepper test suite" /><StackPanel Orientation="Horizontal" Spacing="18"><CheckBox Content="Communication" /><CheckBox Content="Inputs and faults" /><CheckBox Content="Configuration readback" /><CheckBox Content="Motion" /><CheckBox Content="Homing" /></StackPanel><Button HorizontalAlignment="Left" Click="RunTests_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Run Stepper tests" /></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabViewItem>
        </TabView>

        <Grid Grid.Row="3"><ProgressBar x:Name="TestProgress" Width="260" HorizontalAlignment="Left" /><TextBlock x:Name="StatusText" Margin="280,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="Ready" /></Grid>
    </Grid>
</Window>
